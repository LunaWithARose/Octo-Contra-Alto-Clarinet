###############################################################################
# Fusion 360 & CAD file handling
###############################################################################

# Treat Fusion 360 files as binary (prevents corruption)
*.f3d binary
*.f3z binary

# Include Fusion files in GitHub language statistics
*.f3d linguist-detectable=true
*.f3z linguist-detectable=true

# Display them as "Fusion360" in GitHub stats (cosmetic only)
*.f3d linguist-language=Fusion360
*.f3z linguist-language=Fusion360

###############################################################################
# Common 3D/CAD formats (safe)
###############################################################################
*.step binary
*.stp binary
*.iges binary
*.igs binary
*.stl binary
*.obj -text

